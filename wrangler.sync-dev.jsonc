{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kniffel-extreme-sync-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-03-29",
  "durable_objects": {
    "bindings": [
      {
        "name": "KniffelSync",
        "class_name": "KniffelSyncServer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KniffelSyncServer"]
    }
  ]
}
